# Токен бота Telegram (получить: @BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# Токен бота MAX (нужен верифицированный профиль на платформе MAX для партнёров)
MAX_BOT_TOKEN=

# Включённые каналы через запятую: telegram,max
ENABLED_CHANNELS=telegram

# Путь к SQLite (пользователи, подписки, лимиты). По умолчанию ./data/strology.db
DB_PATH=

# Лимит бесплатных действий в день (суммарно на все действия)
FREE_DAILY_LIMIT=1

# Telegram ID администраторов через запятую (для /grant, /revoke). Узнать: @userinfobot
ADMIN_IDS=